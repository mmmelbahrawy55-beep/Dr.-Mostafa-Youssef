# Copy to .env.local for local development (never commit real values).
# Upstash Redis (Vercel → Storage / Marketplace)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Namespace all Redis keys. Use a separate prefix for development so local
# testing never writes into the production database.
REDIS_PREFIX=dev

# Stable session secret. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# First-run admin account (only used when the database has no admin yet).
ADMIN_EMAIL=admin@drmostafayoussef.com
ADMIN_PASSWORD=
